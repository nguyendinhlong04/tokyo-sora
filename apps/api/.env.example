# Copy thành apps/api/.env (đã gitignore) và điền giá trị thật.
# Trên Vercel: khai cùng bộ biến này trong Project Settings → Environment Variables.

# ---------------------------------------------------------------- CSDL
# Runtime: dùng POOLER của Supabase (Supavisor, cổng 6543, chế độ transaction).
# Serverless sinh rất nhiều kết nối ngắn — pooler chính là thứ sinh ra để gom lại.
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Migration: dùng kết nối TRỰC TIẾP (cổng 5432). Pooler chế độ transaction không
# chạy được DDL nhiều câu lệnh và không giữ được session state.
DATABASE_MIGRATION_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Test tích hợp — Postgres cục bộ, KHÔNG trỏ vào Supabase (test xoá sạch schema)
TEST_DATABASE_URL=postgres://postgres:<password>@localhost:5432/sora_test

# Số kết nối tối đa mỗi tiến trình. Bỏ trống để tự chọn: 1 khi chạy trên Vercel,
# 10 khi chạy server thường.
# DATABASE_POOL_MAX=1
# DATABASE_SSL=true

# ------------------------------------------------------------ Realtime
# Supabase Dashboard → Project Settings → API → JWT Secret.
# Dùng để KÝ token cho client nối Realtime; RLS đối chiếu claim trong token.
SUPABASE_JWT_SECRET=

# Client cần hai giá trị này (khai ở project của từng app frontend, tiền tố VITE_)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------- Khác
PORT=3000
# Chỉ khai khi có origin cần gọi chéo; mặc định same-origin qua rewrite của Vercel
# CORS_ORIGINS=https://pos.tokyosora.vn,https://kds.tokyosora.vn
