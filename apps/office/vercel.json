{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "sh $(git rev-parse --show-toplevel)/scripts/vercel-ignore.sh apps/office",
  "framework": "vite",
  "buildCommand": "pnpm --filter @sora/contracts build && pnpm --filter @sora/office build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.tokyo-sora.vn/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.supabase.co https://storage.googleapis.com; media-src 'self' https://*.supabase.co https://storage.googleapis.com; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; form-action 'self'; base-uri 'self'"
        }
      ]
    }
  ]
}
